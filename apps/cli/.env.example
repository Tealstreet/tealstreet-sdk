# Tealstreet CLI Configuration
# All variables marked (required for serve mode) must be set when running serve/pair commands

# Exchange Relay HTTP API URL (required for serve mode)
# Local: http://localhost:3001
# Production: https://exchange.tealstreet.io
TEALSTREET_EXCHANGE_RELAY_URL=

# Exchange Relay WebSocket URL (required for serve mode)
# Local: ws://localhost:3001/ws
# Production: wss://exchange.tealstreet.io/account
TEALSTREET_EXCHANGE_RELAY_WS=

# Web app URL for pairing redirect (required for serve mode)
# Local: http://localhost:3000
# Production: https://tealstreet.io
TEALSTREET_WEB_URL=

# Tealstreet API URL (required for auth)
# Local: http://localhost:3000
# Production: https://tealstreet.io
TEALSTREET_API=
