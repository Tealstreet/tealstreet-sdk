{
  "name": "@tealstreet/cli",
  "version": "0.9.2",
  "description": "Tealstreet CLI - Trade crypto from your terminal",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "tealstreet": "src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tealstreet/tealstreet-next.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "cli": "bun src/index.ts",
    "dev": "bun run src/index.ts",
    "build": "./scripts/build.sh",
    "release": "./scripts/release.sh",
    "lint": "eslint src",
    "version:patch": "yarn version --patch --no-git-tag-version",
    "version:minor": "yarn version --minor --no-git-tag-version",
    "version:major": "yarn version --major --no-git-tag-version",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "logs": "tail -f ~/.tealstreet/cli.log",
    "test": "vitest",
    "test-ci": "vitest run"
  },
  "dependencies": {
    "@tealstreet/cli-core": "*",
    "@tealstreet/safe-cex": "*",
    "@tealstreet/script-api-cli": "*",
    "@tealstreet/script-api-core": "*",
    "@tealstreet/script-api-web": "*",
    "@tealstreet/utils": "*",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "fast-json-patch": "^3.1.1",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "tcp-websocket": "^1.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.7"
  }
}
