{
  "name": "@tealstreet/cli",
  "version": "0.10.19",
  "description": "Tealstreet CLI - Trade crypto from your terminal",
  "main": "bin/tealstreet.cjs",
  "type": "module",
  "bin": {
    "tealstreet": "bin/tealstreet.cjs"
  },
  "files": [
    "bin",
    "scripts/install-binary.cjs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tealstreet/tealstreet-next.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "cli": "bun src/index.ts",
    "dev": "bun run src/index.ts",
    "build": "./scripts/build.sh",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "lint": "eslint src",
    "version:patch": "yarn version --patch --no-git-tag-version",
    "version:minor": "yarn version --minor --no-git-tag-version",
    "version:major": "yarn version --major --no-git-tag-version",
    "typecheck": "node ../../scripts/tsc-ts6.mjs --noEmit --skipLibCheck",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --noEmit --skipLibCheck",
    "logs": "tail -f ~/.tealstreet/cli.log",
    "test": "vitest",
    "test-ci": "vitest run",
    "test-wasm": "SAFE_CEX_WASM_TESTS=1 vitest run .wasm.test.ts --maxWorkers=2",
    "postinstall": "node scripts/install-binary.cjs --optional",
    "torture": "bun scripts/torture-one-shot.ts"
  },
  "devDependencies": {
    "@sentry/bun": "^11.1.0",
    "@tealstreet/cli-core": "*",
    "@tealstreet/oems-core": "*",
    "@tealstreet/safe-cex": "*",
    "@tealstreet/safe-cex-wasm": "*",
    "@tealstreet/script-api-core": "*",
    "@tealstreet/script-api-web": "*",
    "@tealstreet/script-authoring": "*",
    "@tealstreet/service-telemetry": "*",
    "@tealstreet/utils": "*",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.4.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fast-json-patch": "^3.1.1",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "tcp-websocket": "^1.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.2",
    "ws": "^8.21.3"
  },
  "license": "MIT"
}
