{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "paths": {
      "@tealstreet/onchain-core": ["../../packages/onchain-core/src/index.ts"],
      "@tealstreet/onchain-core/*": ["../../packages/onchain-core/src/*"],
      "@tealstreet/prediction-core": ["../../packages/prediction-core/src/index.ts"],
      "@tealstreet/prediction-core/*": ["../../packages/prediction-core/src/*"],
      "@tealstreet/mcp-data": ["../../packages/mcp-data/src/index.ts"],
      "@tealstreet/mcp-data/*": ["../../packages/mcp-data/src/*"]
    },
    "types": ["bun-types", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
