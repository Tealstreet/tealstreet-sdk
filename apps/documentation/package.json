{
  "name": "documentation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:en": "docusaurus start --locale en",
    "start:zh": "docusaurus start --locale zh-CN",
    "start:zh:fresh": "docusaurus clear && docusaurus start --locale zh-CN",
    "lint": "yarn lint:format && yarn build",
    "lint:fix": "yarn lint:format:fix",
    "lint:format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css}\" --ignore-path .prettierignore",
    "lint:format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css}\" --ignore-path .prettierignore",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@algolia/client-search": "^5.59.0",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.14.0",
    "@mdx-js/react": "^3.1.1",
    "@mui/material": "^9.5.0",
    "@popperjs/core": "^2.11.8",
    "@types/react": "^19.3.0",
    "clsx": "^2.1.1",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.2.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "license": "MIT"
}
