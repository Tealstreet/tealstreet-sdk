    },
    {
      "issue": "Concurrent bullet replies recorded by completion order swapped snapshot shard tokens during replay.",
      "fixCommit": "6ba4327e4a",
      "correction": "The generic recorder assigns requestOrdinal before awaiting I/O; replay orders each explicit queue by request initiation. The replacement futures capture exercises reversed completion order."
    },
    {
      "issue": "Same-clock independent Spot engines could mint colliding missing clientOid values.",
      "fixCommit": "3e5df81d46c5a11b1931b31821dcc9c8fb16de52",
      "correction": "Use fallible shared cryptographic uuid generation; preserve caller IDs verbatim and reject the staged batch on entropy failure."
    },
