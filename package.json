{
  "name": "tealstreet-sdk",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/documentation",
    "sdk-rs/hosts/wasm",
    "thirdparty/*"
  ],
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test-ci test-unit",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "check:licenses": "node scripts/check-licenses.mjs",
    "rust:build-wasm": "bash sdk-rs/harness/build.sh",
    "rust:record": "node sdk-rs/harness/record.mjs",
    "rust:private-tape-orderly": "node sdk-rs/harness/private-tape-orderly.mjs",
    "rust:private-tape-backpack": "node sdk-rs/harness/private-tape-backpack.mjs",
    "rust:private-tape": "node sdk-rs/harness/private-tape.mjs",
    "rust:private-tape-bitget-uta": "node sdk-rs/harness/private-tape-bitget-uta.mjs",
    "rust:private-tape-bitgetinverse": "node sdk-rs/harness/private-tape-bitgetinverse.mjs",
    "rust:test-bitget-parity": "node --test sdk-rs/harness/bitget-parity.integration.mjs",
    "rust:private-tape-bitrue": "node sdk-rs/harness/private-tape-bitrue.mjs",
    "rust:private-tape-bitget": "node sdk-rs/harness/private-tape-bitget.mjs",
    "rust:lighter-signing-vectors": "node --import tsx sdk-rs/harness/lighter-signing-vectors.mjs",
    "rust:private-tape-lighter": "node sdk-rs/harness/private-tape-lighter.mjs",
    "rust:private-tape-hyperliquid": "node sdk-rs/harness/private-tape-hyperliquid.mjs",
    "rust:private-tape-mexc": "node sdk-rs/harness/private-tape-mexc.mjs",
    "rust:private-tape-bingx": "node sdk-rs/harness/private-tape-bingx.mjs",
    "rust:private-tape:blofin": "node sdk-rs/harness/private-tape-blofin.mjs",
    "rust:private-tape-bybit": "node sdk-rs/harness/private-tape-bybit.mjs",
    "rust:private-tape-cryptocom": "node sdk-rs/harness/private-tape-cryptocom.mjs",
    "rust:private-tape-kucoin": "node sdk-rs/harness/private-tape-kucoin.mjs",
    "rust:private-tape-okx": "node sdk-rs/harness/private-tape-okx.mjs",
    "rust:private-tape:phemex": "node sdk-rs/harness/private-tape-phemex.mjs",
    "rust:private-tape:weex": "node sdk-rs/harness/private-tape-weex.mjs",
    "rust:trim-tape": "node sdk-rs/harness/trim-tape.mjs",
    "rust:gate": "node sdk-rs/harness/gate.mjs",
    "rust:private-tape-bybitinverse": "node sdk-rs/harness/private-tape-bybit-variants.mjs --venue bybitinverse",
    "rust:private-tape-bybitspot": "node sdk-rs/harness/private-tape-bybit-variants.mjs --venue bybitspot",
    "rust:private-tape-bybitdemo": "node sdk-rs/harness/private-tape-bybit-variants.mjs --venue bybitdemo",
    "rust:private-tape-hyrotrader": "node sdk-rs/harness/private-tape-bybit-variants.mjs --venue hyrotrader",
    "rust:public-tape-hyrotrader": "node sdk-rs/harness/private-tape-bybit-variants.mjs --venue hyrotrader --public",
    "rust:replay": "ESBUILD_WORKER_THREADS=0 node --expose-gc --import tsx sdk-rs/harness/replay.mjs",
    "rust:test-harness": "node --test sdk-rs/harness/*.test.mjs",
    "rust:private-tape-woo": "node sdk-rs/harness/private-tape-woo.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vite": "^8.1.3",
    "tsx": "^4.23.15"
  },
  "packageManager": "yarn@1.22.21",
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.0"
  },
  "resolutions": {
    "eslint": "^9.28.0",
    "axios": "^1.13.2",
    "qs": "^6.14.1",
    "lodash": "4.18.1",
    "bn.js": ">=5.2.3",
    "tweetnacl": "^1.0.3",
    "form-data": "^4.0.4",
    "tough-cookie": "^5.1.1",
    "undici": "^6.23.0",
    "brace-expansion": ">=5.0.5",
    "tar": "^7.5.3",
    "esbuild": "^0.28.1"
  },
  "license": "MIT"
}
