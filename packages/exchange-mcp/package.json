{
  "name": "@tealstreet/exchange-mcp",
  "version": "0.0.0-development",
  "description": "MCP server that trades on one exchange through safe-cex",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crypto",
    "trading",
    "exchange",
    "safe-cex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tealstreet/tealstreet-sdk.git",
    "directory": "packages/exchange-mcp"
  },
  "homepage": "https://github.com/Tealstreet/tealstreet-sdk/tree/master/packages/exchange-mcp#readme",
  "type": "module",
  "bin": {
    "exchange-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/wasm/poseidon_crypto.wasm",
    "dist/wasm/rust",
    "dist/THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/third-party-licenses.mjs",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs && node dist/poseidon-probe.js && node scripts/rust-smoke.mjs",
    "lint": "eslint . --ext .ts --cache --cache-location ../../.cache/eslint/exchange-mcp.eslintcache",
    "test": "vitest run",
    "test-ci": "vitest run",
    "test-wasm": "SAFE_CEX_WASM_TESTS=1 vitest run .wasm.test.ts --maxWorkers=2",
    "typecheck": "node ../../scripts/tsc-ts6.mjs --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tealstreet/cli-core": "*",
    "@tealstreet/poseidon-crypto": "*",
    "@tealstreet/safe-cex": "*",
    "@tealstreet/safe-cex-wasm": "*",
    "@tealstreet/script-api-core": "*",
    "@types/node": "^22.15.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "license": "MIT"
}
