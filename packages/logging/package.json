{
  "name": "@tealstreet/logging",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "echo \"Unrequired and disabled when using tsconfig paths aliases, run 'build-force' to test a build.\"",
    "build-force": "tsup",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "dev": "echo \"Unrequired and disabled when using tsconfig paths aliases, run 'dev-force' to watch a dev version.\"",
    "dev-force": "tsup --watch",
    "fix-all-files": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --fix",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/core-lib.eslintcache",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "node ../../scripts/tsc-ts6.mjs --project ./tsconfig.json --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tealstreet/utils": "*",
    "axios": "^1.17.0",
    "axios-rate-limit": "^1.9.0",
    "axios-retry": "^4.5.0",
    "create-hash": "^1.2.0",
    "create-hmac": "^1.1.7",
    "dayjs": "^1.11.22",
    "dequal": "^2.0.3",
    "jotai": "^2.20.2",
    "lodash": "^4.18.1",
    "nanoid": "~6.0.1",
    "p-iteration": "^1.1.8",
    "qs": "^6.15.3",
    "tiny-emitter": "^2.1.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tealstreet/prettierrc": "*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/create-hash": "^1.2.2",
    "@types/create-hmac": "^1.1.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.15.3",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.9",
    "cross-env": "^7.0.3",
    "eslint": "^9.28.0",
    "happy-dom": "^20.10.6",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^4.1.10"
  }
}
