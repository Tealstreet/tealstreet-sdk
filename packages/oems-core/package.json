{
  "name": "@tealstreet/oems-core",
  "version": "0.1.0",
  "private": true,
  "description": "The narrow OEMS slice: the order-entry/management verbs, read slices and context shapes shared by every runtime that trades on a user's behalf.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "echo \"Source-only via tsconfig path aliases — no build.\"",
    "clean": "rimraf ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/oems-core.eslintcache",
    "test": "vitest run",
    "test-ci": "vitest run",
    "typecheck": "node ../../scripts/tsc-ts6.mjs --project ./tsconfig.json --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tealstreet/math": "*",
    "@tealstreet/script-api-core": "*"
  },
  "devDependencies": {
    "@tealstreet/prettierrc": "*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "license": "MIT"
}
