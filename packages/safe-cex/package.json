    "@noble/hashes": "^2.3.0",
    "@polymarket/clob-client-v2": "1.1.0",
    "@tealstreet/ccxt-compat": "*",
    "@tealstreet/compression": "*",
    "@tealstreet/data-structures": "*",
    "@tealstreet/math": "*",
    "@tealstreet/reconnecting-websocket": "*",
    "@tealstreet/proxy-ips-lists": "*",
    "@tealstreet/utils": "*",
    "@tealstreet/safe-cex-wasm": "*",
    "@tealstreet/lighter-sdk": "*",
    "@tealstreet/poseidon-crypto": "*",
    "@tealstreet/grvt-client": "*",
    "@tealstreet/grvt-ts-sdk": "*",
    "@tealstreet/paradex-sdk": "*",
    "dequal": "^2.0.3",
    "axios": "^1.17.0",
    "axios-rate-limit": "^1.9.0",
    "axios-retry": "^4.5.0",
    "big.js": "^7.0.1",
