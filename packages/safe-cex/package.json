{
  "name": "@tealstreet/safe-cex",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "echo \"Unrequired and disabled when using tsconfig paths aliases, run 'build-force' to test a build.\"",
    "build-force": "tsup",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "dev": "echo \"Unrequired and disabled when using tsconfig paths aliases, run 'dev-force' to watch a dev version.\"",
    "dev-force": "tsup --watch",
    "fix-all-files": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --fix",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/core-lib.eslintcache",
    "test": "run-s test-unit",
    "test-ci": "node --test eslint-rules/*.test.mjs && vitest run",
    "test:lighter-smoke": "vitest run src/exchangeMetadata.test.ts src/__tests__/lighter.utils.test.ts src/__tests__/lighter.signer.test.ts src/__tests__/lighter.ws-private.test.ts",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest watch --ui",
    "test-wasm": "SAFE_CEX_WASM_TESTS=1 vitest run",
    "typecheck": "node ../../scripts/tsc-ts6.mjs --project ./tsconfig.json --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tealstreet/logging": "*",
    "@tealstreet/http-over-websocket": "*",
    "@tealstreet/json-parse": "*",
    "@tealstreet/sleep": "*",
