{
  "default": {
    "canSign": [["key"], ["secret", "remoteSigner", "payloadSigner"]],
    "privateEligible": [["canSign"]]
  },
  "venues": {
    "coinbase": { "canSign": [["key"]] },
    "coinbasespot": { "canSign": [["key"]] },
    "txflow": { "canSign": [["secret"], ["applicationId"]], "privateEligible": [] },
    "polymarket": { "privateEligible": [["key"]] },
    "paradex": {
      "privateEligible": [["key"], ["paradexAddress"], ["subkeyAddress"]],
      "explicitPrivateError": "Rust Paradex private accounts require a key, Paradex address and subkey address"
    },
    "lighter": { "privateEligible": [["secret", "remoteSigner"], ["apiKeyIndex"]] },
    "lighter-robinhood": { "privateEligible": [["secret", "remoteSigner"], ["apiKeyIndex"]] },
    "hyperliquid": { "privateEligible": [["vault", "applicationId", "key"]] },
    "asterdex": { "canSign": [["key"], ["remoteSigner", "asterLocalAuth"]] }
  }
}
