{
  "default": {
    "canSign": [["key"], ["secret", "remoteSigner", "payloadSigner"]],
    "privateEligible": [["canSign"]]
  },
  "venues": {
    "coinbase": {"canSign": [["key"]], "bridge": {"primaryCredentialsOnly": true}},
    "coinbasespot": {"canSign": [["key"]], "bridge": {"spot": true, "primaryCredentialsOnly": true}},
    "txflow": {"canSign": [["secret"], ["applicationId"]], "privateEligible": []},
    "polymarket": {"privateEligible": [["key"]]},
    "paradex": {"privateEligible": [["key"], ["paradexAddress"], ["subkeyAddress"]], "explicitPrivateError": "Rust Paradex private accounts require a key, Paradex address and subkey address", "bridge": {"payloadSigning": true}},
    "lighter": {"privateEligible": [["secret", "remoteSigner"], ["apiKeyIndex"]], "bridge": {"apiKeyIndexRequired": true}},
    "lighter-robinhood": {"privateEligible": [["secret", "remoteSigner"], ["apiKeyIndex"]], "bridge": {"apiKeyIndexRequired": true}},
    "hyperliquid": {"privateEligible": [["vault", "applicationId", "key"]]},
    "asterdex": {"canSign": [["key"], ["remoteSigner", "asterLocalAuth"]], "bridge": {"isolatedBookSubscriptions": true}},
    "bybit": {"bridge": {"dispatchSigning": true}},
    "bybitinverse": {"bridge": {"dispatchSigning": true}},
    "bybitspot": {"bridge": {"spot": true, "dispatchSigning": true}},
    "binance": {"bridge": {"dispatchSigning": true}},
    "binancepm": {"bridge": {"dispatchSigning": true}},
    "binanceinverse": {"bridge": {"dispatchSigning": true}},
    "binancespot": {"bridge": {"spot": true, "dispatchSigning": true}},
    "kucoinspot": {"bridge": {"spot": true}},
    "hyperliquidspot": {"bridge": {"spot": true}},
    "krakenspot": {"bridge": {"spot": true}},
    "bybitdemo": {"bridge": {"demo": "always", "dispatchSigning": true}},
    "hyrotrader": {"bridge": {"demo": "hyroMode", "dispatchSigning": true}}
  }
}
