{
  "name": "@tealstreet/script-api-cli",
  "version": "0.1.0",
  "description": "CLI-runtime extensions for the Tealstreet custom-scripts kernel (REPL metadata surface).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "node ../../scripts/tsc-ts6.mjs --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/script-api-cli.eslintcache",
    "test": "vitest",
    "test-ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tealstreet/script-api-core": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
