{
  "name": "@tealstreet/script-api-core",
  "version": "0.1.0",
  "description": "Portable headless kernel for the Tealstreet custom-scripts runtime (CoreApi, ApiProxy seam, capability + target checks).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/script-api-core.eslintcache",
    "test": "vitest",
    "test-ci": "vitest run"
  },
  "dependencies": {
    "@tealstreet/safe-cex": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
