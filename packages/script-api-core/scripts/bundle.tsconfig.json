{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": "../../..",
    "paths": {
      "@tealstreet/safe-cex": ["packages/safe-cex/src/index.ts"],
      "@tealstreet/safe-cex/*": ["packages/safe-cex/*"],
      "@tealstreet/logging/src": ["packages/logging/src"],
      "@tealstreet/logging/src/*": ["packages/logging/src/*"],
      "@tealstreet/utils/src": ["packages/utils/src"],
      "@tealstreet/utils/src/*": ["packages/utils/src/*"],
      "@tealstreet/math": ["packages/math/src/index.ts"],
      "@tealstreet/math/src": ["packages/math/src"],
      "@tealstreet/math/src/*": ["packages/math/src/*"],
      "@tealstreet/cli-core": ["packages/cli-core/src/index.ts"],
      "@tealstreet/cli-core/src": ["packages/cli-core/src"],
      "@tealstreet/cli-core/src/*": ["packages/cli-core/src/*"],
      "@tealstreet/eye-websocket/*": ["packages/eye-websocket/*"],
      "@tealstreet/http-over-websocket/*": ["packages/http-over-websocket/*"],
      "@tealstreet/json-parse/*": ["packages/json-parse/*"],
      "@tealstreet/sleep/*": ["packages/sleep/*"],
      "@tealstreet/compression/*": ["packages/compression/*"],
      "@tealstreet/data-structures/src": ["packages/data-structures/src"],
      "@tealstreet/data-structures/src/*": ["packages/data-structures/src/*"],
      "@tealstreet/reconnecting-websocket/src": ["thirdparty/reconnecting-websocket/src"],
      "@tealstreet/reconnecting-websocket/src/*": ["thirdparty/reconnecting-websocket/src/*"],
      "@tealstreet/proxy-ips-lists/src": ["packages/proxy-ips-lists/src"],
      "@tealstreet/proxy-ips-lists/src/*": ["packages/proxy-ips-lists/src/*"],
      "@tealstreet/ccxt-compat/src": ["packages/ccxt-compat/src"],
      "@tealstreet/ccxt-compat/src/*": ["packages/ccxt-compat/src/*"],
      "@tealstreet/lighter-sdk": ["packages/lighter-sdk/src/index.ts"],
      "@tealstreet/lighter-sdk/src": ["packages/lighter-sdk/src"],
      "@tealstreet/lighter-sdk/src/*": ["packages/lighter-sdk/src/*"],
      "@tealstreet/poseidon-crypto": ["packages/poseidon-crypto/src/index.ts"],
      "@tealstreet/poseidon-crypto/src": ["packages/poseidon-crypto/src"],
      "@tealstreet/poseidon-crypto/src/*": ["packages/poseidon-crypto/src/*"],
      "@tealstreet/grvt-client": ["thirdparty/grvt-js-client/src/index.ts"],
      "@tealstreet/grvt-client/src": ["thirdparty/grvt-js-client/src"],
      "@tealstreet/grvt-client/src/*": ["thirdparty/grvt-js-client/src/*"],
      "@tealstreet/grvt-ts-sdk": ["thirdparty/grvt-ts-sdk/src/index.ts"],
      "@tealstreet/grvt-ts-sdk/src": ["thirdparty/grvt-ts-sdk/src"],
      "@tealstreet/grvt-ts-sdk/src/*": ["thirdparty/grvt-ts-sdk/src/*"],
      "@tealstreet/paradex-sdk": ["thirdparty/paradex.js/src/index.ts"],
      "@tealstreet/paradex-sdk/src": ["thirdparty/paradex.js/src"],
      "@tealstreet/paradex-sdk/src/*": ["thirdparty/paradex.js/src/*"]
    }
  }
}
