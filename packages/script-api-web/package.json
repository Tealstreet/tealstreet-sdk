{
  "name": "@tealstreet/script-api-web",
  "version": "0.1.0",
  "description": "Web-runtime extensions for the Tealstreet custom-scripts kernel (React, components, UI-token resolvers, DOM hotkey triggers).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/script-api-web.eslintcache",
    "test": "vitest",
    "test-ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tealstreet/script-api-core": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
