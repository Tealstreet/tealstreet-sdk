{
  "name": "@tealstreet/script-authoring",
  "version": "0.1.0",
  "description": "Validation + AI-drafting core for Tealstreet custom scripts. Transport-agnostic: consumed by the CLI MCP server and the web AI editor alike.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "node ../../scripts/tsc-ts6.mjs --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/script-authoring.eslintcache",
    "test": "vitest",
    "test-ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tealstreet/script-api-core": "*",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
