{
  "name": "@tealstreet/script-authoring",
  "version": "0.1.0",
  "description": "Validation + AI-drafting core for Tealstreet custom scripts. Transport-agnostic: consumed by the hosted MCP connector and the web editor alike.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "node ../../scripts/tsc-ts6.mjs --noEmit",
    "typecheck:ts7": "node ../../scripts/tsc-ts7.mjs --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs --cache --cache-location ../../.cache/eslint/script-authoring.eslintcache",
    "test": "vitest",
    "check:script-types": "vitest run src/script-types-bundle.test.ts",
    "test-ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tealstreet/script-api-core": "*",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "dts-bundle-generator": "9.5.1",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "private": true
}
