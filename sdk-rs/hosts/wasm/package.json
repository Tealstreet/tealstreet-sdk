{
  "name": "@tealstreet/safe-cex-wasm",
  "version": "0.0.1",
  "private": true,
  "description": "The Rust exchange engine for browsers and Workers: wasm build, host and frame reader",
  "type": "module",
  "exports": {
    "./host": {
      "types": "./js/host.d.mts",
      "default": "./js/host.mjs"
    },
    "./wire": {
      "types": "./js/wire.d.mts",
      "default": "./js/wire.mjs"
    },
    "./workers": {
      "types": "./js/workers.d.mts",
      "default": "./js/workers.mjs"
    },
    "./web": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/web/safe_cex_wasm.js"
    },
    "./node": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/node/safe_cex_wasm.js"
    },
    "./engine": {
      "types": "./js/loader.d.mts",
      "browser": "./js/engine.web.mjs",
      "node": "./js/engine.node.mjs",
      "default": "./js/engine.web.mjs"
    },
    "./engine/web": {
      "types": "./js/loader.d.mts",
      "default": "./js/engine.web.mjs"
    },
    "./venues": {
      "types": "./js/venues.d.mts",
      "default": "./js/venues.mjs"
    }
  },
  "scripts": {
    "build-wasm": "bash ../../harness/build.sh",
    "test": "node --test js/*.test.mjs",
    "test-host": "node --test js/host.test.mjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "license": "MIT"
}
