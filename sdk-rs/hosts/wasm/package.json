{
  "name": "@tealstreet/safe-cex-wasm",
  "version": "0.0.1",
  "private": true,
  "description": "The Rust exchange engine for browsers and Workers: wasm build, host and frame reader",
  "type": "module",
  "exports": {
    "./host": {
      "types": "./js/host.d.mts",
      "default": "./js/host.mjs"
    },
    "./wire": {
      "types": "./js/wire.d.mts",
      "default": "./js/wire.mjs"
    },
    "./workers": "./js/workers.mjs",
    "./venues": {
      "types": "./js/venues.d.mts",
      "default": "./js/venues.mjs"
    },
    "./web/binance": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/web/binance/safe_cex_wasm.js"
    },
    "./web/bybit": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/web/bybit/safe_cex_wasm.js"
    },
    "./web/okx": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/web/okx/safe_cex_wasm.js"
    },
    "./node/binance": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/node/binance/safe_cex_wasm.js"
    },
    "./node/bybit": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/node/bybit/safe_cex_wasm.js"
    },
    "./node/okx": {
      "types": "./js/engine.d.mts",
      "default": "./pkg/node/okx/safe_cex_wasm.js"
    }
  },
  "scripts": {
    "build-wasm": "bash ../../harness/build.sh",
    "test": "node --test js/*.test.mjs",
    "check-sizes": "node ../../harness/check-wasm-sizes.mjs"
  },
  "license": "MIT"
}
