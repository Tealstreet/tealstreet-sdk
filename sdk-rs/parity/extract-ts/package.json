    "typecheck": "node ../../../scripts/tsc-ts6.mjs --project tsconfig.json --noEmit",
    "lint": "node ../../../node_modules/eslint/bin/eslint.js src --max-warnings=0"
  },
  "dependencies": {
    "smol-toml": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.28.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
