    "call": "{ let value = $type($value.as_str().expect(\"text witness\")); if value.is_nan() { serde_json::json!(\"NaN\") } else if value == f64::INFINITY { serde_json::json!(\"Infinity\") } else if value == f64::NEG_INFINITY { serde_json::json!(\"-Infinity\") } else if value == 0.0 && value.is_sign_negative() { serde_json::json!(\"-0\") } else { serde_json::json!(value.to_string()) } }",
