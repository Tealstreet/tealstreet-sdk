        "output": "0"
      },
      {
        "input": "-0",
        "output": "-0"
      },
      {
        "input": "Infinitytail",
        "output": "Infinity"
      },
      {
        "input": "-Infinitytail",
        "output": "-Infinity"
      },
      {
        "input": "1e400",
        "output": "Infinity"
      },
      {
