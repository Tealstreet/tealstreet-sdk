{
  "target": "esnext",
  "module": "esnext",
  "moduleResolution": "bundler",
  "lib": ["dom", "dom.iterable", "esnext"],
  "allowJs": true,
  "skipLibCheck": true,
  "strict": true,
  "strictNullChecks": true,
  "noEmit": true,
  "esModuleInterop": true,
  "noErrorTruncation": true,
  "resolveJsonModule": true,
  "isolatedModules": true,
  "jsx": "preserve",
  "incremental": false,
  "ignoreDeprecations": "6.0"
}
