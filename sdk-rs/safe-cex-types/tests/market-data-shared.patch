ting them meant every\n *         caller placing a bare stop had to go around this surface, which is\n *         how the CLI's `stop` command ended up sending an unrounded trigger.\n *         `triggerPrice` is rounded to the venue tick like `price`.\n * 1.3.1 — `api.constants.ExchangeName` gains `txflow`, matching the\n *         safe-cex ExchangeName union for the dev-only TxFlow scaffold.\n * 1.3.2 — `api.constants.ExchangeName` gains `binanceinverse`, matching the\n *         safe-cex ExchangeName union for Binance COIN-M inverse support.\n * 1.3.3 — `api.constants.ExchangeName` gains `binanceoptions`, matching the\n *         safe-cex ExchangeName union for Binance European options.\n */\nexport declare const CORE_API_VERSION = \"1.3.3\";\nexport declare const CORE_CONSTANTS: CoreConstants;\nexport declare const CORE_UTILS: CoreUtils;\nexport declare const adjust: (value: number, step: number) => number;\nexport declare const formatPnl: (value: number, opts?: FormatPnlOpts) => string;\nexport declare const getBBOMid: (ticker: Ticker, market?: Market | null) => number;\n/**\n * Get correct candle for binning in seconds\n * @param timeframe\n * @param timeInSeconds\n */\nexport declare const getCandleEndTime: (timeframe: Timeframe | SecondsTimeframe, timeInSeconds: number) => number;\n/**\n * Get correct candle for binning in seconds\n * @param timeframe\n * @param timeInSeconds\n */\nexport declare const getCandleStartTime: (timeframe: Timeframe | SecondsTimeframe, timeInSeconds: number) => number;\nexport declare const getFarTouchPrice: (side: OrderSide, ticker: Ticker, market?: Market | null) => number;\nexport declare const getMarginCurrency: (market: Market) => string;\nexport declare const getNearTouchPrice: (side: OrderSide, ticker: Ticker, market?: Market | null) => number;\nexport declare const getNumCandlesInRange: (timeframe: Timeframe, from: number, to: number) => number;\nexport declare const getTickerPredictedBestAsk: (ticker: Ticker, market?: Market | undefined | null) => number;\nexport declare const getTickerPredictedBestBid: (ticker: Ticker, market?: Market | undefined | null) => number;\nexport declare const normalizeEpochToSeconds: (epoch: number) => number;\n/**\n * Resolve after `ms` milliseconds. See SPEC §2.1 api.utils.sleep.\n */\nexport declare const sleep: (ms: number) => Promise<void>;\n/**\n * Generate a v4 UUID. Backed by `crypto.randomUUID()` which is available in\n * Node 19+, Bun, Deno, and all modern browsers — the only runtimes script-api\n * targets. See SPEC §2.1 api.utils.uuid.\n */\nexport declare const uuid: () => string;\nexport declare enum MarginType {\n\tIsolated = \"isolated\",\n\tCross = \"cross\"\n}\nexport declare enum OrderSide {\n\tBuy = \"buy\",\n\tSell = \"sell\"\n}\nexport declare enum OrderStatus {\n\tOpen = \"open\",\n\tClosed = \"closed\",\n\tCanceled = \"canceled\",\n\tCreating = \"creating\",\n\tUpdating = \"updating\",\n\tCanceling = \"canceling\"\n}\nexport declare enum OrderStopTriggerType {\n\tMarkPrice = \"mark_price\",\n\tLastPrice = \"last_price\",\n\tIndexPrice = \"index_price\"\n}\nexport declare enum OrderTimeInForce {\n\tGoodTillCancel = \"GoodTillCancel\",\n\tImmediateOrCancel = \"ImmediateOrCancel\",\n\tFillOrKill = \"FillOrKill\",\n\tPostOnly = \"PostOnly\"\n}\nexport declare enum OrderType {\n\tMarket = \"market\",\n\tLimit = \"limit\",\n\tConditional = \"conditional\",\n\tStopLoss = \"stop_market\",\n\tTakeProfit = \"take_profit_market\",\n\tTrailingStopLoss = \"trailing_stop_market\"\n}\nexport declare enum PositionMode {\n\tHedged = \"hedged\",\n\tOneWay = \"oneway\"\n}\nexport declare enum PositionSide {\n\tLong = \"long\",\n\tShort = \"short\"\n}\nexport declare function calculateReturns(position: Pick<Position, \"unrealizedPnl\" | \"contracts\" | \"entryPrice\" | \"leverage\">, overrideUPNL?: number): {\n\troe: number;\n\troi: number;\n};\n/**\n * Convert a symbol between any two exchanges.\n * Goes through Binance canonical format as the common 