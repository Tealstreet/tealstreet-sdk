treadonly symbols: readonly string[];\n\t/** Original command line post-substitution. Scripts can re-parse if needed. */\n\treadonly raw: string;\n}\n/**\n * Authoring-side shape — what a script's source file declares via\n * `export const meta: ScriptMeta = { ... }`. This is the public-facing\n * type users `import type` from `@tealstreet/script-api-core` when\n * editing their `~/.tealstreet/scripts/*.ts` files (SPEC §5.1).\n *\n * Distinct from `ScriptRecord` (in runScript.ts): `ScriptMeta` is what\n * the script file declares, `ScriptRecord` is what the loader builds\n * by combining `ScriptMeta` with filesystem metadata (name from\n * filename, optional `fn` reference from the default export).\n */\nexport interface ScriptMeta {\n\treadonly targets: readonly TargetName[];\n\treadonly capabilities: Capabilities;\n\t/**\n\t * Stamped per-target at save time so the runtime can refuse to load\n\t * scripts written against a future surface this host hasn't shipped\n\t * yet (SPEC §2.5 `targetCheck`). Optional in v1 — when omitted, the\n\t * validator treats it as `0.0.0` and any non-zero runtime version\n\t * passes.\n\t */\n\treadonly coreApiVersion?: string;\n\treadonly cliApiVersion?: string;\n\treadonly webApiVersion?: string;\n\treadonly mobileApiVersion?: string;\n}\nexport interface StorageCapability {\n\treadonly enabled: boolean;\n\t/** Per-script storage cap in bytes. Default 102_400 (100 KB). */\n\treadonly quotaBytes: number;\n}\n/**\n * An amend. `order` is accepted for callers that already hold the row, and\n * IGNORED — every adapter re-resolves the live order by id before amending,\n * because the caller's copy is a snapshot and the venue's is not. It is\n * optional so a caller holding only an id need not fabricate an `Order` whose\n * every field is discarded.\n *\n * `amount` is the order's new TOTAL in native units, filled part included. An\n * order's `remaining` is base, so doubling it on a contract venue misstates the\n * size by the contract size: convert with `convertBaseToNative` and add the fill.\n */\nexport interface UpdateOrderPatch {\n\treadonly order?: Order;\n\treadonly update: {\n\t\treadonly amount: number;\n\t} | {\n\t\treadonly price: number;\n\t};\n}\nexport type Balance = {\n\treadonly used: number;\n\treadonly free: number;\n\treadonly total: number;\n\treadonly upnl: number;\n\treadonly info?: any;\n\treadonly currencies?: {\n\t\t[currency: string]: Balance;\n\t};\n\treadonly coins?: {\n\t\t[coin: string]: CoinBalance;\n\t};\n};\nexport type Candle = {\n\treadonly timestamp: number;\n\treadonly open: number;\n\treadonly high: number;\n\treadonly low: number;\n\treadonly close: number;\n\treadonly volume: number;\n\treadonly lastSide?: OrderSide;\n};\nexport type CoinBalance = {\n\tbase: string;\n\tamount: number;\n\tnotional: number;\n};\nexport type ExchangeName = \"apexomni\" | \"asterdex\" | \"backpack\" | \"binance\" | \"binanceinverse\" | \"binanceoptions\" | \"binancespot\" | \"binancepm\" | \"bingx\" | \"bitget\" | \"bitgetinverse\" | \"bitgetusdc\" | \"bitrue\" | \"bitunix\" | \"blofin\" | \"bybit\" | \"bybitdemo\" | \"bybitinverse\" | \"bybitspot\" | \"hyrotrader\" | \"coinbase\" | \"coinbasespot\" | \"cryptocom\" | \"grvt\" | \"hyperliquid\" | \"hyperliquidspot\" | \"lighter\" | \"lighter-robinhood\" | \"mexc\" | \"okx\" | \"okxdemo\" | \"okxeu\" | \"okxeudemo\" | \"paradex\" | \"phemex\" | \"polymarket\" | \"kodiakfi\" | \"mode\" | \"txflow\" | \"what\" | \"weex\" | \"woo\" | \"woofi\" | \"kucoin\" | \"kucoinspot\" | \"kraken\" | \"krakenspot\";\n/**\n * The full ExchangeName union as a frozen literal-map. ExchangeName itself\n * is a TS union (not an enum), so api.constants.ExchangeName ships a\n * plain frozen object whose keys mirror the union members.\n * Kept in step with @tealstreet/safe-cex/src/types ExchangeName.\n */\nexport type ExchangeNameMap = Readonly<Record<ExchangeName, ExchangeName>>;\nexport type InvokedFrom = \"cli\" | \"hotkey\" | \"webhook\" | \"inline\";\nexport type Market = {\n\treadonly id: string;\n\treadonly symbol: string;\n\treadonly prettySymbol?: string;\n\treadonly base: string;\n\treadonly quote: string;\n\treadonly active: boolean;\n\treadonly precision: {\n\t\treadonly amount: number;\n\t\treadonly price: number;\n\t};\n\treadonly limits: {\n\t\treadonly amount: {\n\t\t\treadonly min: number;\n\t\t\treadonly max: number;\n\t\t};\n\t\treadonly leverage: {\n\t\t\treadonly min: number;\n\t\t\treadonly max: number;\n\t\t};\n\t\treadonly price?: {\n\t\t\treadonly min: number;\n\t\t};\n\t};\n\treadonly option?: OptionTerms;\n\treadonly contractSize?: number;\n\treadonly isExpiring?: boolean;\n\treadonly isInverse?: boolean;\n\treadonly isSpot?: boolean;\n\treadonly isPerpetual?: boolean;\n\treadonly isReadOnly?: boolean;\n\treadonly info?: any;\n\treadonly takerFee?: number;\n\treadonly makerFee?: number;\n};\n/**\n * Greeks as the venue publishes them; `units` records what was measured.\n */\nexport type OptionGreeks = {\n\treadonly delta: number;\n\treadonly gamma: number;\n\treadonly vega: number;\n\treadonly theta: number;\n\treadonly units: string;\n};\nexport type OptionRight = \"call\" | \"put\";\n/** What makes a market an option. Absent on every other market. */\nexport type OptionTerms = {\n\treadonly underlying: string;\n\t/** Expiry, ms since epoch. */\n\treadonly expiry: number;\n\treadonly strike: number;\n\treadonly right: OptionRight;\n\treadonly style: \"european\";\n\treadonly settlement: \"cash\";\n\t/** The asset the premium is quoted in, which is the unit of `price` on an option order. */\n\treadonly premiumAsset: string;\n\treadonly settleAsset: string;\n};\nexport type Order = {\n\treadonly id: string;\n\treadonly parentId?: string;\n\treadonly status: OrderStatus;\n\treadonly symbol: string;\n\treadonly type: OrderType;\n\treadonly side: OrderSide;\n\treadonly price: number;\n\treadonly amount: number;\n\treadonly filled: number;\n\treadonly remaining: number;\n\treadonly reduceOnly: boolean;\n\treadonly close?: boolean;\n\treadonly info?: any;\n\treadonly clientOrderId?: string;\n\treadonly timeInForce?: OrderTimeInForce;\n\treadonly lastUpdate: number;\n\treadonly triggerType?: OrderStopTriggerType;\n\treadonly tpTriggerType?: OrderStopTriggerType;\n\treadonly slTriggerType?: OrderStopTriggerType;\n\treadonly takeProfit?: number;\n\treadonly stopLoss?: number;\n\treadonly extra?: {\n\t\treadonly remainingNative?: number;\n\t\treadonly filledInPlacementUnits?: number;\n\t\treadonly remainingNotional?: number;\n\t\treadonly conditionalOrderPrice?: number;\n\t\treadonly rejectReason?: OrderRejectReason;\n\t\treadonly isFromChaser?: boolean;\n\t\treadonly chaserId?: string;\n\t\treadonly chaserAttempts?: number;\n\t\treadonly chaserMaxAttempts?: number;\n\t};\n};\nexport type OrderBook = {\n\tbids: Array<OrderBookOrders>;\n\tasks: Array<OrderBookOrders>;\n};\nexport type OrderBookOrders = {\n\tprice: number;\n\tamount: number;\n\ttotal: number;\n};\n/**\n * Canonical SDK position. liquidationPrice is required and null when the threshold is unavailable.\n * contracts is the whole base-unit quantity; extra.contractsNative retains native placement units.\n * marginSize is absolute quote-currency margin when published by the venue; cross margin may be zero.\n */\nexport type Position = {\n\treadonly id: string;\n\treadonly symbol: string;\n\treadonly side: PositionSide;\n\treadonly entryPrice: number;\n\treadonly notional: number;\n\treadonly leverage: number;\n\treadonly marginType?: MarginType;\n\treadonly positionMode?: PositionMode;\n\treadonly unrealizedPnl: number;\n\treadonly realizedPnl?: number;\n\treadonly contracts: number;\n\treadonly liquidationPrice: number | null;\n\treadonly marginSize?: number;\n\treadonly info?: any;\n\treadonly extra?: {\n\t\treadonly contractsNative?: number;\n\t\treadonly unrealizedPnlNative?: number;\n\t};\n\treadonly lastUpdate?: number;\n\treadonly option?: {\n\t\treadonly greeks?: OptionGreeks;\n\t};\n};\n/** SPEC §7.4 — print severity. */\nexport type PrintKind = \"print\" | \"success\" | \"info\" | \"warn\" | \"error\";\n/**\n * The set of getX method names a script may invoke.\n * When `Capabilities.reads` is undefined, all reads are permitted\n * (matches the v1 author-only model per SPEC §4.1 + §12 design call #10).\n */\nexport type ReadMethodName = \"getActiveAccount\" | \"getActiveAccounts\" | \"getActiveSymbol\" | \"getActiveExchange\" | \"getAccounts\" | \"getMarkets\" | \"getMarket\" | \"getTicker\" | \"getTickers\" | \"getPositions\" | \"getHistoricalPosition\" | \"getOrders\" | \"getBalance\" | \"getCombinedBalance\" | \"getOrderbook\" | \"getCandles\";\nexport type SecondsTimeframe = \"1s\" | \"5s\" | \"15s\" | \"30s\";\nexport type TargetName = \"core\" | \"cli\" | \"web\" | \"mobile\";\nexport type Ticker = {\n\treadonly observedAt?: TickerObservedAt;\n\treadonly id: string;\n\treadonly symbol: string;\n\treadonly bid: number;\n\treadonly ask: number;\n\treadonly last: number;\n\t/**\n\t * Derivatives metadata uses `0` when the venue does not publish the field,\n\t * including spot venues where the concept does not apply. Consumers must\n\t * not interpret zero as proof of a real zero funding rate, mark/index price,\n\t * funding time, or open-interest value.\n\t */\n\treadonly mark: number;\n\treadonly index: number;\n\t/**\n\t * Exchange-published midpoint when the venue exposes one separately\n\t * from `(bid + ask) / 2`. Hyperliquid publishes `midPx` directly\n\t * (and their `bid`/`ask` are impact-weighted, not L1 quotes), so\n\t * consumers who want the canonical mid should prefer this when\n\t * set and fall back to `(bid + ask) / 2` otherwise. Most exchanges\n\t * leave this unset.\n\t */\n\treadonly midPrice?: number;\n\treadonly percentage: number;\n\treadonly openInterest: number;\n\treadonly fundingRate: number;\n\treadonly fundingTime: number;\n\treadonly volume: number;\n\treadonly quoteVolume: number;\n\treadonly info?: any;\n};\n/** Source engine receipt times for last, mark and index; null is unobserved. */\nexport type TickerObservedAt = [\n\tnumber | null,\n\tnumber | null,\n\tnumber | null\n];\nexport type Timeframe = \"1m\" | \"3m\" | \"5m\" | \"15m\" | \"30m\" | \"1h\" | \"2h\" | \"4h\" | \"6h\" | \"12h\" | \"1d\" | \"1w\";\nexport type UpdateOrderOpts = {\n\treadonly order: Order;\n\treadonly update: {\n\t\treadonly amount: number;\n\t} | {\n\t\treadonly price: number;\n\t};\n};\n/**\n * The set of exchange.* method names a script may invoke.\n * Kept as string literals (not a TS enum) so the runtime can validate\n * against a frozen allowlist without pulling in the action surface.\n */\nexport type WriteMethodName = \"placeOrder\" | \"placeOrders\" | \"cancelOrder\" | \"cancelOrders\" | \"updateOrder\" | \"closePosition\" | \"setLeverage\" | \"setPositionMode\" | \"setMarginType\" | \"runCommand\";\n}\n";

 export const WEB_TYPES_DTS = "declare module '@tealstreet/script-api-web' {\nexport declare const QUICK_SIZE_SLOTS: readonly QuickSizeSlot[];\n/**\n * The UI-only token names, and the string → number conversion the host\n * applies when adapting `UITokenResolvers` (`@tealstreet/cli-core`) to\n * `WebAdapter`.\n *\n * The resolvers return complete tokens (`\"$100\"`, `\"50000\"`) rather than bare\n * numbers because the CLI's substitute layer requires that — see\n * `packages/cli-core/src/preprocess/types.ts`. Script authors want numbers,\n * so the conversion happens once, here, instead of in every consumer.\n */\nexport declare const UI_TOKENS: Readonly<{\n\tclick: \"$click\";\n\torderSize: \"$ordersize\";\n\t/** `$quick1` … `$quick7`. */\n\tquick: (slot: QuickSizeSlot) => string;\n}>;\n/**\n * Independent from CORE_API_VERSION and CLI_API_VERSION — see SPEC §2.3.\n *\n * 1.0.0 — WebApi surface: `ui` token resolvers ($click / $ordersize /\n *         $quick1-7), `domHotkey` registration seam, and host-augmented\n *         `react` / `components` interfaces. `WebAdapter` is the contract\n *         `apps/web` implements; the implementation cannot live here (it\n *         needs the jotai store and controllers — see\n *         docs/custom-scripts/CONVERGENCE-AUDIT-v1.md §B3).\n *\n * Raising this from 0.0.0 is strictly more permissive: `targetCheck` only\n * rejects when the runtime provides LESS than a script requires, and a\n * script's omitted `webApiVersion` is treated as 0.0.0.\n */\nexport declare const WEB_API_VERSION = \"1.0.0\";\n/**\n * Runtime guard for {@link DomTarget}.\n *\n * Deliberately NOT a type predicate. A duck-type on `addEventListener` also\n * matches `WebSocket`, `XMLHttpRequest`, `AbortSignal`, `MediaQueryList`,\n * SVG elements and text nodes, so narrowing to `HTMLElement | Document |\n * Window` on that basis would be a lie the compiler then trusts. Callers that\n * need a real narrowing should use `instanceof` against their own realm.\n */\nexport declare const canAddEventListener: (value: unknown) => boolean;\n/** Whether `value` is a DOM target in *this* realm. Cross-realm (iframe)\n *  objects fail this check even when they are valid targets there. */\nexport declare const isDomTarget: (value: unknown) => value is DomTarget;\nexport declare const isQuickSizeSlot: (value: number) => value is QuickSizeSlot;\n/**\n * Parse a resolver token into a number. Handles the bare-numeric form\n * (`$click` → `\"50000\"`) and the `$`-prefixed size form (`\"$100\"`).\n * Returns `undefined` for a missing value or any token shape that has no\n * numeric meaning — notably percent-sized quick buttons.\n */\nexport declare const parseUIToken: (token: string | undefined) => number | undefined;\n/**\n * `WebAdapter` — what `apps/web` implements so the kernel can build a\n * `WebApi`. The `CoreAdapter` analogue (see\n * `@tealstreet/script-api-core`'s `AdapterContext`), and it lives here for\n * the same reason: the *contract* is portable, the *implementation* is not.\n *\n * The implementation cannot live in this package. It needs the jotai store,\n * `exchangeAccountController`, and `apps/web` atoms — importing those would\n * invert the dependency direction. See\n * `docs/custom-scripts/CONVERGENCE-AUDIT-v1.md` §B3.\n *\n * Note the return types: the host's underlying resolvers\n * (`UITokenResolvers` from `@tealstreet/cli-core`) hand back **token\n * strings** such as `\"$100\"` or `\"50000\"`, because the CLI's substitute\n * layer requires complete tokens rather than bare numbers. This adapter is\n * the seam where those become numbers for script authors.\n */\nexport interface WebAdapter {\n\t/** Last chart-click price. Host parses the numeric token string. */\n\tgetClick(): number | undefined;\n\t/** Order-form size as USD notional. Host strips the `$` token prefix. */\n\tgetOrderSize(): number | undefined;\n\t/** Quick-button size as USD notional, or `undefined` for non-`$` units. */\n\tgetQuickSize(slot: QuickSizeSlot): number | undefined;\n\treadonly domHotkey: WebDomHotkey;\n\treadonly react: WebReact;\n\treadonly components: WebComponents;\n}\nexport interface WebApi {\n\treadonly react: WebReact;\n\treadonly components: WebComponents;\n\treadonly ui: WebUi;\n\treadonly domHotkey: WebDomHotkey;\n}\n/** Empty on purpose and NOT yet augmentable — see the note above. */\nexport interface WebComponents {\n}\nexport interface WebDomHotkey {\n\t/**\n\t * Register `cb` on `target` and return an unsubscribe function.\n\t *\n\t * Callers MUST invoke the returned function. A script that registers a DOM\n\t * listener and is then re-run — the editor re-transpiles on save — would\n\t * otherwise stack a second live listener on the same target, so one\n\t * keypress fires the handler N times after N edits. The kernel cannot\n\t * clean these up on the script's behalf; this is the only mechanism.\n\t */\n\tregister(target: DomTarget, cb: () => void): DomHotkeyUnsubscribe;\n}\n/**\n * `WebApi` — the web-runtime extension tier. Mounted by `apps/web` only and\n * unreachable from the standalone CLI. See SPEC §2.3.\n *\n * Two deliberate deviations from the SPEC §2.3 sketch, both load-bearing:\n *\n * 1. **`react` and `components` are declared but EMPTY, and currently carry\n *    no autocomplete.** Read this before assuming otherwise.\n *\n *    Typing them here as `typeof import('react')` /\n *    `ComponentType<ButtonProps>` would pull `@types/react` into\n *    `scripts/generate-monaco-types.ts`'s dts-bundle-generator output, which\n *    emits a triple-slash reference directive for the types library. The\n *    bundler wraps that output in `declare module\n *    '@tealstreet/script-api-web' { … }`, and such a directive inside a\n *    module block is invalid TypeScript — it would corrupt the seeded\n *    `~/.tealstreet/scripts/types.d.ts` for every user. Enumerating the\n *    component map is also impossible from here: the real components live in\n *    `apps/web`, and importing them would invert the dependency direction\n *    (see `docs/custom-scripts/CONVERGENCE-AUDIT-v1.md`).\n *\n *    **A host-side `declare module` augmentation does NOT fix this.**\n *    `WEB_TYPES_DTS` is generated from this package's `src/index.ts` alone,\n *    so an augmentation living in `apps/web` never reaches the bundle: a\n *    script author gets `components: {}` and\n *    \"Property 'Button' does not exist\". Two things must land together\n *    before these fields are useful, both belonging to the web-editor epic:\n *\n *      - the bundle generator must be taught to concatenate a host-supplied\n *        augmentation slice, and\n *      - that augmentation must target the *declaration*, not `index.ts`'s\n *        re-exported alias — merging into an alias symbol is not supported,\n *        and this repo has no precedent for it (every existing\n *        `declare module` here is an ambient shim for an untyped module).\n *\n *    Until then these exist for shape fidelity with SPEC §2.3 and to keep\n *    `WebApi` stable, nothing more. Do not document them to users as working.\n *\n * 2. **`ui.*` is synchronous and returns numbers.** SPEC §2.3 sketched\n *    `Promise<number | undefined>`, but the real resolvers\n *    (`UITokenResolvers` in `@tealstreet/cli-core`, implemented at\n *    `apps/web/src/components/cli/uiTokenResolvers.ts`) are sync and return\n *    *token strings* like `\"$100\"`. Making this async would be pretending.\n *    `WebAdapter` is where the string → number conversion happens.\n */\n/** Empty on purpose and NOT yet augmentable — see the note above. */\nexport interface WebReact {\n}\n/**\n * UI-token resolvers. Each returns `undefined` when no value is available\n * right now (no chart click yet, empty order form, unset quick button) —\n * callers must treat that as \"missing\", not as zero.\n */\nexport interface WebUi {\n\t/** Last chart-click price, in the symbol's quote currency. */\n\tgetClick(): number | undefined;\n\t/**\n\t * Size from the linked order form, as **USD notional** — not contracts.\n\t * Resolves the first non-zero of buy/sell market then buy/sell limit size\n\t * and converts via the current ticker price.\n\t */\n\tgetOrderSize(): number | undefined;\n\t/**\n\t * Quick-size button value as **USD notional**. Returns `undefined` for a\n\t * button whose unit is not `$` / `k` / `m` (e.g. a percent-sized button),\n\t * since those have no notional meaning without a position.\n\t */\n\tgetQuickSize(slot: QuickSizeSlot): number | undefined;\n}\n/** Returned by {@link WebDomHotkey.register}; call it to detach. */\nexport type DomHotkeyUnsubscribe = () => void;\n/** What a DOM hotkey can be bound to. */\nexport type DomTarget = HTMLElement | Document | Window;\n/** `$quick<n>` button slots, n in 1..7. */\nexport type QuickSizeSlot = 1 | 2 | 3 | 4 | 5 | 6 | 7;\n}\n";
