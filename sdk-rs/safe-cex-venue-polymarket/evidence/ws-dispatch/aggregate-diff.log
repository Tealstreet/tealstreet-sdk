diff --git a/sdk-rs/safe-cex-exchange/src/cross_trade/helpers.rs b/sdk-rs/safe-cex-exchange/src/cross_trade/helpers.rs
new file mode 100644
index 0000000000..4fdd2edc93
--- /dev/null
+++ b/sdk-rs/safe-cex-exchange/src/cross_trade/helpers.rs
@@ -0,0 +1,116 @@
+use super::*;
+use safe_cex_num::sizing::{
+    convert_from_margin_to_quote, get_margin_currency, get_total_balance_from_balance,
+};
+use safe_cex_types::symbol_converter::convert_symbol;
+
+pub fn get_copier_symbol_from_master(
+    copier: &CrossTradeCopier,
+    copier_exchange: Option<&ExchangeName>,
+    master_exchange: &ExchangeName,
+    master_symbol: &str,
+) -> String {
+    if let Some(mapped) = copier
+        .symbol_mappings
+        .get(master_symbol)
+        .filter(|value| !value.is_empty())
+    {
+        return mapped.clone();
+    }
+    copier_exchange.map_or_else(
+        || master_symbol.into(),
+        |exchange| convert_symbol(master_symbol, master_exchange, exchange),
+    )
+}
+pub fn get_master_symbol_from_copier(
+    config: &CrossTradeConfig,
+    copier: &CrossTradeCopier,
+    master_exchange: Option<&ExchangeName>,
+    copier_exchange: &ExchangeName,
+    copier_symbol: &str,
+) -> String {
+    // lodash invert iterates own keys in JS order; duplicate values keep the last key.
+    let mut reversed = JsObjectMap::<String>::new();
+    for (key, value) in &copier.symbol_mappings {
+        reversed.insert(value.clone(), key.clone());
+    }
+    if let Some(symbol) = config.master_symbol.as_ref().filter(|v| !v.is_empty()) {
+        return symbol.clone();
+    }
+    if let Some(symbol) = reversed.get(copier_symbol).filter(|v| !v.is_empty()) {
+        return symbol.clone();
+    }
+    master_exchange.map_or_else(
+        || copier_symbol.into(),
+        |exchange| convert_symbol(copier_symbol, copier_exchange, exchange),
+    )
+}
+// Source-owned currencyUtils rules. Keep one native implementation for callers.
+pub fn is_btc_like_symbol(symbol: &str) -> bool {
+    symbol.starts_with("BTC") || symbol.starts_with("XBT")
+}
+pub fn is_equivalent_currency(a: &str, b: &str) -> bool {
+    let usd = |v: &str| {
+        matches!(
+            v,
+            "USD" | "USDT" | "BUSD" | "USDC" | "FDUSD" | "USDY" | "USDD" | "USDP"
+        )
+    };
+    a == b || (usd(a) && usd(b)) || (matches!(a, "BTC" | "XBT") && matches!(b, "BTC" | "XBT"))
+}
+pub fn get_copier_weight_ratio(
+    config: &CrossTradeConfig,
+    copier: &CrossTradeCopier,
+    master: &CrossTradeStore,
+    copy: &CrossTradeStore,
+    master_market: &Market,
+    copier_market: &Market,
+) -> f64 {
+    let master_weight = if truthy(config.master_weight) {
+        config.master_weight
+    } else {
+        1.0
+    };
+    let mut ratio = copier.weight / master_weight;
+    if copier.weight_mode == CrossTradWeightMode::Balance {
+        let copier_margin =
+            get_total_balance_from_balance(copy.balance.as_ref(), Some(copier_market));
+        let master_margin =
+            get_total_balance_from_balance(master.balance.as_ref(), Some(master_market));
+        if !truthy(copier_margin) || !truthy(master_margin) {
+            return 0.0;
+        }
+        if is_equivalent_currency(
+            get_margin_currency(Some(copier_market), ""),
+            get_margin_currency(Some(master_market), ""),
+        ) {
+            ratio *= copier_margin / master_margin;
+        } else {
+            let quote = |amount, market: &Market, store: &CrossTradeStore| {
+                let btc = if safe_cex_num::js_truthy(
+                    market.info.as_ref().and_then(|v| v.get("isQuanto")),
+                ) {
+                    store
+                        .tickers
+                        .iter()
+                        .find(|ticker| is_btc_like_symbol(&ticker.symbol))
+                        .map(|ticker| ticker.last)
+                } else {
+                    None
+                };
+                convert_from_margin_to_quote(
+                    amount,
+                    market,
+                    store
+                        .tickers_by_symbol
+                        .get(&market.symbol)
+                        .map(|ticker| ticker.last),
+                    btc,
+                )
+            };
+            ratio *= quote(copier_margin, copier_market, copy)
+                / quote(master_margin, master_market, master);
+        }
+    }
+    if ratio.is_finite() { ratio.abs() } else { 0.0 }
+}
diff --git a/sdk-rs/safe-cex-exchange/src/cross_trade/manager.rs b/sdk-rs/safe-cex-exchange/src/cross_trade/manager.rs
new file mode 100644
index 0000000000..bdc460529d
--- /dev/null
+++ b/sdk-rs/safe-cex-exchange/src/cross_trade/manager.rs
@@ -0,0 +1,571 @@
+use super::{helpers::*, *};
+use safe_cex_num::sizing::convert_from_base_size_to_native;
+use safe_cex_types::PositionSide;
+use std::{cell::RefCell, collections::HashMap};
+#[derive(Clone)]
+pub struct CrossTradeManagerDeps {
+    pub get_exchange: CrossTradeGetExchangeFn,
+    pub place_order: CrossTradePlaceOrderFn,
+    pub runtime: Rc<dyn CrossTradeRuntime>,
+}
+#[derive(Debug, Clone, Copy, Default)]
+pub struct FailureEntry {
+    pub failures: f64,
+    pub muted_until: f64,
+}
+pub fn debug(runtime: &dyn CrossTradeRuntime, message: &str) {
+    runtime.debug(&format!("[CrossTradeManager] {message}"));
+}
+pub struct CrossTradeManager {
+    current_loop: RefCell<Option<CrossTradeLoop>>,
+    failures: RefCell<HashMap<String, Rc<Cell<FailureEntry>>>>,
+    deps: CrossTradeManagerDeps,
+}
+impl CrossTradeManager {
+    pub fn new(deps: CrossTradeManagerDeps) -> Rc<Self> {
+        Rc::new(Self {
+            current_loop: RefCell::new(None),
+            failures: RefCell::new(HashMap::new()),
+            deps,
+        })
+    }
+    pub fn loop_state(&self) -> Option<CrossTradeLoop> {
+        self.current_loop.borrow().clone()
+    }
+    pub fn get_exchange(
+        &self,
+        account: &str,
+    ) -> Result<Option<Rc<dyn CrossTradeExchange>>, ExchangeError> {
+        (self.deps.get_exchange)(account)
+    }
+    pub fn place_order(
+        &self,
+        request: CrossTradeOrder,
+    ) -> ExchangeFuture<'static, Option<CrossTradeValue>> {
+        (self.deps.place_order)(request)
+    }
+    pub fn failure_key(account: &str, symbol: &str) -> String {
+        format!("{account}:{symbol}")
+    }
+    pub fn failure_entry(&self, account: &str, symbol: &str) -> Option<FailureEntry> {
+        self.failures
+            .borrow()
+            .get(&Self::failure_key(account, symbol))
+            .map(|entry| entry.get())
+    }
+    pub fn is_muted(&self, account: &str, symbol: &str) -> bool {
+        self.failure_entry(account, symbol)
+            .is_some_and(|entry| entry.muted_until > self.deps.runtime.now_ms())
+    }
+    pub fn record_failure(&self, account: &str, symbol: &str) {
+        let key = Self::failure_key(account, symbol);
+        let entry = self
+            .failures
+            .borrow()
+            .get(&key)
+            .cloned()
+            .unwrap_or_else(|| Rc::new(Cell::new(FailureEntry::default())));
+        let mut state = entry.get();
+        state.failures += 1.0;
+        entry.set(state);
+        if state.failures >= 2.0 {
+            // Capture the same entry through reentrant clock/log callbacks;
+            // an existing entry is already updated before those callbacks.
+            let until = self.deps.runtime.now_ms() + 30_000.0;
+            state = entry.get();
+            state.muted_until = until;
+            entry.set(state);
+            debug(
+                self.deps.runtime.as_ref(),
+                &format!("Muting {key} until {until}"),
+            );
+        }
+        self.failures.borrow_mut().insert(key, entry);
+    }
+
+    pub fn record_success(&self, account: &str, symbol: &str) {
+        self.failures
+            .borrow_mut()
+            .remove(&Self::failure_key(account, symbol));
+    }
+    pub fn meets_min_amount(market: &Market, amount: f64) -> bool {
+        let minimum = market.limits.amount.min;
+        if minimum <= 0.0 {
+            true
+        } else {
+            amount.abs() >= minimum
+        }
+    }
+    pub fn safe_place_order(
+        self: &Rc<Self>,
+        request: CrossTradeOrder,
+    ) -> ExchangeFuture<'static, Option<CrossTradeValue>> {
+        if self.is_muted(&request.account, &request.market.symbol) {
+            debug(
+                self.deps.runtime.as_ref(),
+                &format!(
+                    "Skipping muted {} {}",
+                    request.account, request.market.symbol
+                ),
+            );
+            return done(Ok(None));
+        }
+        if !request.reduce_only && !Self::meets_min_amount(&request.market, request.amount) {
+            debug(
+                self.deps.runtime.as_ref(),
+                &format!(
+                    "Skipping below-min-amount order {} {} {} min {}",
+                    request.account,
+                    request.market.symbol,
+                    request.amount,
+                    request.market.limits.amount.min
+                ),
+            );
+            return done(Ok(None));
+        }
+        let pending = self.place_order(request.clone());
+        let manager = self.clone();
+        Box::pin(async move {
+            match pending.await {
+                Ok(value) => {
+                    manager.record_success(&request.account, &request.market.symbol);
+                    Ok(value)
+                }
+                Err(_error) => {
+                    manager.record_failure(&request.account, &request.market.symbol);
+                    Ok(None)
+                }
+            }
+        })
+    }
+    pub fn audit_copier_positions(
+        self: &Rc<Self>,
+        config: &CrossTradeConfig,
+        copier: &CrossTradeCopier,
+        master: Rc<dyn CrossTradeExchange>,
+        copy: Rc<dyn CrossTradeExchange>,
+    ) -> ExchangeFuture<'static, Vec<Option<CrossTradeValue>>> {
+        let Some(account) = copier
+            .account
+            .as_ref()
+            .filter(|account| !account.is_empty())
+        else {
+            return done(Ok(vec![]));
+        };
+        let weight = if truthy(config.master_weight) {
+            config.master_weight
+        } else {
+            1.0
+        };
+        let hedged = copier.weight / weight < 0.0;
+        let cs = copy.store();
+        let cn = copy.name();
+        let ms = master.store();
+        let mn = master.name();
+        let master_positions: Vec<_> = ms
+            .positions
+            .iter()
+            .filter(|position| truthy(position.contracts))
+            .collect();
+        let relevant = config
+            .master_symbol
+            .as_ref()
+            .filter(|v| !v.is_empty())
+            .map(|symbol| get_copier_symbol_from_master(copier, Some(&cn), &mn, symbol));
+        let positions: Vec<_> = cs
+            .positions
+            .iter()
+            .filter(|position| {
+                truthy(position.contracts)
+                    && relevant
+                        .as_ref()
+                        .is_none_or(|symbol| symbol.is_empty() || position.symbol == *symbol)
+            })
+            .collect();
+        let mut requests = vec![];
+        for position in positions {
+            let cm = cs
+                .markets
+                .iter()
+                .find(|market| market.symbol == position.symbol);
+            let ct = cs
+                .tickers
+                .iter()
+                .find(|ticker| ticker.symbol == position.symbol);
+            let symbol =
+                get_master_symbol_from_copier(config, copier, Some(&mn), &cn, &position.symbol);
+            let mm = ms.markets.iter().find(|market| market.symbol == symbol);
+            let mt = ms.tickers.iter().find(|ticker| ticker.symbol == symbol);
+            let (Some(cm), Some(mm)) = (cm, mm) else {
+                debug(
+                    self.deps.runtime.as_ref(),
+                    &format!("Could not find market for {} {symbol}", position.symbol),
+                );
+                requests.push(done(Ok(None)));
+                continue;
+            };
+            let mut order_price = ct.map(|ticker| ticker.last);
+            let mut reference = order_price;
+            if cm.base == mm.base {
+                reference = first_price(
+                    first_price(reference, mt.map(|ticker| ticker.last)),
+                    Some(position.entry_price),
+                );
+                order_price = first_price(order_price, mt.map(|ticker| ticker.last));
+            }
+            if !reference.is_some_and(truthy) {
+                requests.push(done(Ok(None)));
+                continue;
+            }
+            let selected = copier.symbol_mappings.get(&symbol);
+            let found = if selected.is_none_or(|v| v.is_empty() || *v == position.symbol) {
+                master_positions
+                    .iter()
+                    .find(|p| {
+                        p.symbol == symbol
+                            && if hedged {
+                                p.side != position.side
+                            } else {
+                                p.side == position.side
+                            }
+                    })
+                    .copied()
+            } else {
+                None
+            };
+            let (side, amount, reduce_only) = if let Some(found) = found {
+                let ratio =
+                    get_copier_weight_ratio(config, copier, &master.store(), &copy.store(), mm, cm);
+                let mut size = found.contracts.abs();
+                if mm.base != cm.base {
+                    if !mt.is_some_and(|t| truthy(t.last)) || !ct.is_some_and(|t| truthy(t.last)) {
+                        debug(self.deps.runtime.as_ref(), "No ticker for size conversion");
+                        requests.push(done(Ok(None)));
+                        continue;
+                    }
+                    size = mt.unwrap().last * size / ct.unwrap().last;
+                }
+                let copier_size = position.contracts.abs();
+                if !truthy(ratio) {
+                    requests.push(done(Ok(None)));
+                    continue;
+                }
+                let difference = size * ratio - copier_size;
+                let native = convert_from_base_size_to_native(difference, cm, reference.unwrap());
+                if native == 0.0 || !((difference / position.contracts).abs() > 0.05) {
+                    requests.push(done(Ok(None)));
+                    continue;
+                }
+                // Source nested comparisons use >0 in both branches; NaN selects Buy for short.
+                let side = if position.side == PositionSide::Long {
+                    if native > 0.0 {
+                        OrderSide::Buy
+                    } else {
+                        OrderSide::Sell
+                    }
+                } else if native > 0.0 {
+                    OrderSide::Sell
+                } else {
+                    OrderSide::Buy
+                };
+                (side, native.abs(), native < 0.0)
+            } else {
+                let amount = position
+                    .extra
+                    .as_ref()
+                    .and_then(|extra| extra.contracts_native)
+                    .filter(|value| truthy(*value))
+                    .unwrap_or(position.contracts)
+                    .abs();
+                (
+                    if position.side == PositionSide::Long {
+                        OrderSide::Sell
+                    } else {
+                        OrderSide::Buy
+                    },
+                    amount,
+                    true,
+                )
+            };
+            requests.push(self.safe_place_order(CrossTradeOrder {
+                copier: copier.clone(),
+                market: cm.clone(),
+                reference_price: order_price,
+                account: account.clone(),
+                side,
+                amount,
+                reduce_only,
+            }));
+        }
+        Box::pin(join_all(requests))
+    }
+    pub fn audit_master_positions(
+        self: &Rc<Self>,
+        config: &CrossTradeConfig,
+        copier: &CrossTradeCopier,
+        master: Rc<dyn CrossTradeExchange>,
+        copy: Rc<dyn CrossTradeExchange>,
+    ) -> ExchangeFuture<'static, Vec<Option<CrossTradeValue>>> {
+        let Some(account) = copier
+            .account
+            .as_ref()
+            .filter(|account| !account.is_empty())
+        else {
+            return done(Ok(vec![]));
+        };
+        let weight = if truthy(config.master_weight) {
+            config.master_weight
+        } else {
+            1.0
+        };
+        let hedged = copier.weight / weight < 0.0;
+        let cs = copy.store();
+        let cn = copy.name();
+        let mn = master.name();
+        let ms = master.store();
+        let positions: Vec<_> = ms
+            .positions
+            .iter()
+            .filter(|position| {
+                truthy(position.contracts)
+                    && config
+                        .master_symbol
+                        .as_ref()
+                        .is_none_or(|symbol| symbol.is_empty() || position.symbol == *symbol)
+            })
+            .collect();
+        let copier_positions: Vec<_> = cs
+            .positions
+            .iter()
+            .filter(|position| truthy(position.contracts))
+            .collect();
+        let mut requests = vec![];
+        for position in positions {
+            let mm = ms
+                .markets
+                .iter()
+                .find(|market| market.symbol == position.symbol);
+            let mt = ms
+                .tickers
+                .iter()
+                .find(|ticker| ticker.symbol == position.symbol);
+            let symbol = get_copier_symbol_from_master(copier, Some(&cn), &mn, &position.symbol);
+            let cm = cs.markets.iter().find(|market| market.symbol == symbol);
+            let ct = cs.tickers.iter().find(|ticker| ticker.symbol == symbol);
+            let (Some(cm), Some(mm)) = (cm, mm) else {
+                debug(
+                    self.deps.runtime.as_ref(),
+                    &format!("Could not find market for {} {symbol}", position.symbol),
+                );
+                requests.push(done(Ok(None)));
+                continue;
+            };
+            let mut reference = ct.map(|ticker| ticker.last);
+            let mut order_price = reference;
+            if cm.base == mm.base {
+                reference = first_price(
+                    first_price(reference, mt.map(|ticker| ticker.last)),
+                    Some(position.entry_price),
+                );
+                order_price = first_price(order_price, mt.map(|ticker| ticker.last));
+            }
+            if !reference.is_some_and(truthy) {
+                requests.push(done(Ok(None)));
+                continue;
+            }
+            let found = copier_positions.iter().find(|p| {
+                p.symbol == symbol
+                    && if hedged {
+                        p.side != position.side
+                    } else {
+                        p.side == position.side
+                    }
+            });
+            if found.is_some() {
+                requests.push(done(Ok(None)));
+                continue;
+            }
+            let mut size = position.contracts.abs();
+            if mm.base != cm.base {
+                if !mt.is_some_and(|t| truthy(t.last)) || !ct.is_some_and(|t| truthy(t.last)) {
+                    debug(self.deps.runtime.as_ref(), "No ticker for size conversion");
+                    requests.push(done(Ok(None)));
+                    continue;
+                }
+                size = mt.unwrap().last * size / ct.unwrap().last;
+            } else {
+                reference = first_price(
+                    first_price(reference, mt.map(|t| t.last)),
+                    Some(position.entry_price),
+                );
+                order_price = first_price(order_price, mt.map(|t| t.last));
+            }
+            let ratio =
+                get_copier_weight_ratio(config, copier, &master.store(), &copy.store(), mm, cm);
+            if !truthy(ratio) || !reference.is_some_and(truthy) {
+                requests.push(done(Ok(None)));
+                continue;
+            }
+            let amount = convert_from_base_size_to_native(size * ratio, cm, reference.unwrap());
+            let ordinary = if position.side == PositionSide::Long {
+                OrderSide::Buy
+            } else {
+                OrderSide::Sell
+            };
+            let side = if hedged {
+                if ordinary == OrderSide::Buy {
+                    OrderSide::Sell
+                } else {
+                    OrderSide::Buy
+                }
+            } else {
+                ordinary
+            };
+            requests.push(self.safe_place_order(CrossTradeOrder {
+                copier: copier.clone(),
+                market: cm.clone(),
+                reference_price: order_price,
+                account: account.clone(),
+                side,
+                amount,
+                reduce_only: false,
+            }));
+        }
+        Box::pin(join_all(requests))
+    }
+    fn process_config(
+        self: &Rc<Self>,
+        config: CrossTradeConfig,
+        disposed: Rc<Cell<bool>>,
+    ) -> ExchangeFuture<'static, ()> {
+        let Some(account) = config.master_account.as_ref().filter(|v| !v.is_empty()) else {
+            debug(
+                self.deps.runtime.as_ref(),
+                "No master account for cross trade config",
+            );
+            return done(Ok(()));
+        };
+        let master = match self.get_exchange(account) {
+            Ok(Some(exchange)) => exchange,
+            Ok(None) => {
+                debug(self.deps.runtime.as_ref(), "Master exchange not loaded");
+                return done(Ok(()));
+            }
+            Err(error) => return done(Err(error)),
+        };
+        if !master.store().positions_loaded {
+            debug(self.deps.runtime.as_ref(), "Master exchange not loaded");
+            return done(Ok(()));
+        }
+        let mut requests = vec![];
+        for copier in &config.copiers {
+            let Some(account) = copier
+                .account
+                .as_ref()
+                .filter(|v| !v.is_empty() && copier.enabled)
+            else {
+                debug(self.deps.runtime.as_ref(), "Invalid copier");
+                requests.push(done(Ok(())));
+                continue;
+            };
+            let copy = match self.get_exchange(account) {
+                Ok(Some(exchange)) => exchange,
+                Ok(None) => {
+                    debug(self.deps.runtime.as_ref(), "No copier exchange");
+                    requests.push(done(Ok(())));
+                    continue;
+                }
+                Err(error) => {
+                    requests.push(done(Err(error)));
+                    continue;
+                }
+            };
+            if !copy.store().positions_loaded {
+                debug(self.deps.runtime.as_ref(), "Copier exchange not loaded");
+                requests.push(done(Ok(())));
+                continue;
+            }
+            let pending =
+                self.audit_copier_positions(&config, copier, master.clone(), copy.clone());
+            let config = config.clone();
+            let copier = copier.clone();
+            let manager = self.clone();
+            let master = master.clone();
+            let disposed = disposed.clone();
+            requests.push(Box::pin(async move {
+                pending.await?;
+                if manager.current_loop.borrow().is_none() || disposed.get() {
+                    return Ok(());
+                }
+                manager
+                    .audit_master_positions(&config, &copier, master, copy)
+                    .await?;
+                Ok(())
+            }));
+        }
+        Box::pin(async move { join_all(requests).await.map(|_| ()) })
+    }
+    pub fn run_loop(
+        self: &Rc<Self>,
+        configs: Rc<Vec<CrossTradeConfig>>,
+        disposed: Rc<Cell<bool>>,
+    ) -> ExchangeFuture<'static, ()> {
+        if self.current_loop.borrow().is_none() || disposed.get() {
+            return done(Ok(()));
+        }
+        // Deliberately no config.enabled guard: the source ignores that flag.
+        let requests = configs
+            .iter()
+            .map(|config| self.process_config(config.clone(), disposed.clone()))
+            .collect();
+        let manager = self.clone();
+        Box::pin(async move {
+            if let Err(error) = join_all(requests).await {
+                manager
+                    .deps
+                    .runtime
+                    .error("Error in cross trade manager", &error);
+            }
+            if manager.current_loop.borrow().is_some() && !disposed.get() {
+                let next = manager
+                    .current_loop
+                    .borrow()
+                    .as_ref()
+                    .unwrap()
+                    .callback
+                    .clone();
+                manager.deps.runtime.schedule_loop(next, 3000);
+            }
+            Ok(())
+        })
+    }
+    pub fn start(self: &Rc<Self>, configs: Vec<CrossTradeConfig>) {
+        if let Some(previous) = self.current_loop.borrow().as_ref() {
+            previous.disposed.set(true);
+        }
+        debug(self.deps.runtime.as_ref(), "Starting cross trade manager");
+        let disposed = Rc::new(Cell::new(false));
+        let state = disposed.clone();
+        let configs = Rc::new(configs);
+        let manager = Rc::downgrade(self);
+        let callback: CrossTradeLoopFn = Rc::new(move || {
+            manager.upgrade().map_or_else(
+                || done(Ok(())),
+                |manager| manager.run_loop(configs.clone(), state.clone()),
+            )
+        });
+        self.deps.runtime.schedule_loop(callback.clone(), 3000);
+        *self.current_loop.borrow_mut() = Some(CrossTradeLoop { disposed, callback });
+    }
+    pub fn stop(&self) {
+        let has_loop = self.current_loop.borrow().is_some();
+        if has_loop {
+            debug(self.deps.runtime.as_ref(), "Stopping cross trade manager");
+            // Source re-reads this._loop after logging; host logging can reenter start.
+            if let Some(current) = self.current_loop.borrow().as_ref() {
+                current.disposed.set(true);
+            }
+        }
+        self.failures.borrow_mut().clear();
+    }
+}
diff --git a/sdk-rs/safe-cex-exchange/src/cross_trade/mod.rs b/sdk-rs/safe-cex-exchange/src/cross_trade/mod.rs
new file mode 100644
index 0000000000..933d8edd16
--- /dev/null
+++ b/sdk-rs/safe-cex-exchange/src/cross_trade/mod.rs
@@ -0,0 +1,122 @@
+//! Source: packages/safe-cex/src/crossTrade. Native host assembly is explicit.
+pub mod helpers;
+pub mod manager;
+pub mod place_order;
+pub mod types;
+use crate::runtime::{ExchangeError, ExchangeFuture};
+use safe_cex_types::{
+    ActiveChaser, Balance, ExchangeName, Market, OrderSide, PlaceOrderOpts, Position, Ticker,
+    object_map::JsObjectMap,
+};
+use std::{any::Any, cell::Cell, rc::Rc};
+pub use types::*;
+
+#[derive(Debug, Clone, Default, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CrossTradeStore {
+    pub positions_loaded: bool,
+    pub positions: Vec<Position>,
+    pub markets: Vec<Market>,
+    pub tickers: Vec<Ticker>,
+    pub tickers_by_symbol: JsObjectMap<Ticker>,
+    pub balance: Option<Balance>,
+    pub active_chasers: Vec<ActiveChaser>,
+}
+pub type CrossTradeValue = Rc<dyn Any>;
+pub type CrossTradePlaceOrderFn =
+    Rc<dyn Fn(CrossTradeOrder) -> ExchangeFuture<'static, Option<CrossTradeValue>>>;
+pub type CrossTradeGetExchangeFn =
+    Rc<dyn Fn(&str) -> Result<Option<Rc<dyn CrossTradeExchange>>, ExchangeError>>;
+pub type CrossTradeLoopFn = Rc<dyn Fn() -> ExchangeFuture<'static, ()>>;
+#[derive(Clone)]
+pub struct CrossTradeOrder {
+    pub copier: CrossTradeCopier,
+    pub market: Market,
+    pub reference_price: Option<f64>,
+    pub account: String,
+    pub side: OrderSide,
+    pub amount: f64,
+    pub reduce_only: bool,
+}
+#[derive(Debug, Clone, PartialEq)]
+pub struct ChaserStart {
+    pub symbol: String,
+    pub size: f64,
+    pub side: OrderSide,
+    pub max_attempts: f64,
+    pub reduce_only: bool,
+    pub delay: f64,
+}
+pub trait CrossTradeExchange {
+    fn name(&self) -> ExchangeName;
+    /// Returns a native snapshot; arbitrary JS getters/alias mutation are excluded.
+    fn store(&self) -> CrossTradeStore;
+    /// Start work eagerly; opaque results retain their native identity.
+    fn place_order(
+        &self,
+        order: PlaceOrderOpts,
+    ) -> ExchangeFuture<'static, Option<CrossTradeValue>>;
+    fn chaser_terminate(&self, id: &str) -> Result<(), ExchangeError>;
+    fn chaser_start(&self, options: ChaserStart) -> Result<(), ExchangeError>;
+    fn warning(&self, message: &str) -> Result<(), ExchangeError>;
+}
+pub trait CrossTradeRuntime {
+    fn now_ms(&self) -> f64;
+    fn debug(&self, message: &str);
+    fn error(&self, message: &str, error: &ExchangeError);
+    /// Bind the canonical loop scheduler. Enqueue after the supplied interval;
+    /// never invoke the callback inline. Host owns and drives returned work.
+    fn schedule_loop(&self, callback: CrossTradeLoopFn, min_interval_ms: u64);
+}
+#[derive(Clone)]
+pub struct CrossTradeLoop {
+    pub(crate) disposed: Rc<Cell<bool>>,
+    pub(crate) callback: CrossTradeLoopFn,
+}
+impl CrossTradeLoop {
+    pub fn is_disposed(&self) -> bool {
+        self.disposed.get()
+    }
+    pub fn run(&self) -> ExchangeFuture<'static, ()> {
+        (self.callback)()
+    }
+}
+/// Poll all requests, preserving input order like Promise.all. Requests are
+/// created eagerly by callers; native drop/error cancellation is a CHOSEN seam.
+pub async fn join_all<T>(
+    requests: Vec<ExchangeFuture<'static, T>>,
+) -> Result<Vec<T>, ExchangeError> {
+    let mut pending: Vec<_> = requests.into_iter().map(Some).collect();
+    let mut results: Vec<Option<T>> = (0..pending.len()).map(|_| None).collect();
+    std::future::poll_fn(move |cx| {
+        for (index, request) in pending.iter_mut().enumerate() {
+            if let Some(future) = request {
+                match future.as_mut().poll(cx) {
+                    std::task::Poll::Ready(Ok(value)) => {
+                        results[index] = Some(value);
+                        *request = None;
+                    }
+                    std::task::Poll::Ready(Err(error)) => {
+                        return std::task::Poll::Ready(Err(error));
+                    }
+                    std::task::Poll::Pending => {}
+                }
+            }
+        }
+        if pending.iter().all(Option::is_none) {
+            std::task::Poll::Ready(Ok(results.iter_mut().map(|v| v.take().unwrap()).collect()))
+        } else {
+            std::task::Poll::Pending
+        }
+    })
+    .await
+}
+pub(crate) fn truthy(value: f64) -> bool {
+    value != 0.0 && !value.is_nan()
+}
+pub(crate) fn first_price(a: Option<f64>, b: Option<f64>) -> Option<f64> {
+    if a.is_some_and(truthy) { a } else { b }
+}
+pub(crate) fn done<T: 'static>(result: Result<T, ExchangeError>) -> ExchangeFuture<'static, T> {
+    Box::pin(async move { result })
+}
diff --git a/sdk-rs/safe-cex-exchange/src/cross_trade/place_order.rs b/sdk-rs/safe-cex-exchange/src/cross_trade/place_order.rs
new file mode 100644
index 0000000000..9ea3558830
--- /dev/null
+++ b/sdk-rs/safe-cex-exchange/src/cross_trade/place_order.rs
@@ -0,0 +1,118 @@
+use super::*;
+use safe_cex_types::OrderType;
+#[derive(Clone)]
+pub struct CrossTradePlaceOrderDeps {
+    pub get_exchange: CrossTradeGetExchangeFn,
+    pub runtime: Rc<dyn CrossTradeRuntime>,
+}
+pub fn debug(runtime: &dyn CrossTradeRuntime, message: &str) {
+    runtime.debug(&format!("[CrossTradeManager] {message}"));
+}
+pub fn create_cross_trade_place_order(deps: CrossTradePlaceOrderDeps) -> CrossTradePlaceOrderFn {
+    Rc::new(move |request| {
+        // Everything before placeOrder's await runs at invocation, like JS async.
+        let exchange = match (deps.get_exchange)(&request.account) {
+            Ok(Some(exchange)) => exchange,
+            Ok(None) => return done(Ok(None)),
+            Err(error) => return done(Err(error)),
+        };
+        let symbol = &request.market.symbol;
+        if request.copier.execution == CrossTradeExecution::Chase {
+            let store = exchange.store();
+            let active: Vec<_> = store
+                .active_chasers
+                .iter()
+                .filter(|chaser| {
+                    !chaser.is_stopped && chaser.symbol == *symbol && chaser.side == request.side
+                })
+                .collect();
+            if active.len() > 1
+                || active
+                    .first()
+                    .is_some_and(|chaser| chaser.size == request.amount)
+            {
+                debug(
+                    deps.runtime.as_ref(),
+                    &format!("Chaser already active for {symbol} {:?}", request.side),
+                );
+                return done(Ok(None));
+            }
+            if let Some(chaser) = active.first()
+                && let Err(error) = exchange.chaser_terminate(&chaser.id)
+            {
+                return done(Err(error));
+            }
+            if !truthy(request.amount) {
+                debug(deps.runtime.as_ref(), &format!("Amount is 0 for {symbol}"));
+                return done(Ok(None));
+            }
+            return done(
+                exchange
+                    .chaser_start(ChaserStart {
+                        symbol: symbol.clone(),
+                        size: request.amount,
+                        side: request.side,
+                        max_attempts: 1000.0,
+                        reduce_only: request.reduce_only,
+                        delay: 1000.0,
+                    })
+                    .map(|_| None),
+            );
+        }
+        if request.copier.execution == CrossTradeExecution::LimitSlippage
+            && !request.reference_price.is_some_and(truthy)
+        {
+            debug(
+                deps.runtime.as_ref(),
+                &format!("No reference price for {symbol}"),
+            );
+            return done(Ok(None));
+        }
+        if !truthy(request.amount) {
+            debug(deps.runtime.as_ref(), &format!("Amount is 0 for {symbol}"));
+            return done(Ok(None));
+        }
+        let limit = request.copier.execution == CrossTradeExecution::LimitSlippage;
+        let mut order = crate::order_operations::order_options(
+            symbol.clone(),
+            request.side,
+            if limit {
+                OrderType::Limit
+            } else {
+                OrderType::Market
+            },
+            request.amount,
+        );
+        order.reduce_only = Some(request.reduce_only);
+        if limit {
+            let slip = if request.side == OrderSide::Buy {
+                1.0 + 0.009
+            } else {
+                1.0 - 0.009
+            };
+            let precision = request.market.precision.price;
+            order.price = Some(safe_cex_num::adjust(
+                request.reference_price.unwrap() * slip,
+                if truthy(precision) { precision } else { 0.01 },
+            ));
+        }
+        let pending = exchange.place_order(order);
+        let runtime = deps.runtime.clone();
+        let symbol = symbol.clone();
+        Box::pin(async move {
+            match pending.await {
+                Ok(value) => Ok(value),
+                Err(error) => {
+                    runtime.error("CrossTradeManager Failed to place order", &error);
+                    // Source Error.message rather than String(Error); no venue-local coercion.
+                    exchange.warning(&format!(
+                        "Cross Trade: failed to place {} order on {symbol}: {}",
+                        if limit { "limit" } else { "market" },
+                        error.message
+                    ))?;
+                    Err(error)
+                }
+            }
+        })
+    })
+}
diff --git a/sdk-rs/safe-cex-exchange/src/cross_trade/types.rs b/sdk-rs/safe-cex-exchange/src/cross_trade/types.rs
